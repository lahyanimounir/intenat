flowchart TB
  classDef socle fill:#183153,color:#fff,stroke:#183153
  classDef admis fill:#f5f3ff,stroke:#7c3aed,color:#0f172a
  classDef sejour fill:#f0fdf4,stroke:#15803d,color:#0f172a
  classDef resto fill:#fff7ed,stroke:#c2410c,color:#0f172a
  classDef pilot fill:#f1f5f9,stroke:#475569,color:#0f172a
  subgraph S["1 - Socle commun"]
    direction LR
    ORG[Organisation administrative]:::socle --> UTI[Utilisateurs, rôles, périmètres]:::socle --> CST[Comptes stagiaires]:::socle
  end
  subgraph A["2 - Admissions"]
    direction LR
    CAM[Campagnes]:::admis --> INS[Inscription et candidature]:::admis --> VER[Vérification et instruction]:::admis --> CLA[Classement et délibération]:::admis --> ATT[Liste d'attente]:::admis
  end
  subgraph H["3 - Séjour"]
    direction LR
    PLA[Plan d'occupation]:::sejour --> AFF[Affectation et hébergement]:::sejour --> PAY[Paiements mensuels]:::sejour
    AFF --> RST[Restauration]:::resto
    AFF --> VIE[Sorties, absences, incidents]:::sejour
    AFF --> REC[Réclamations]:::sejour
  end
  PIL[4 - Tableaux de bord, statistiques, exports, journal d'audit]:::pilot
  S ==>|structures, périmètres, comptes| A
  A ==>|admis, place confirmée| H
  H ==>|indicateurs| PIL
