APP_NAME="Maisons des Stagiaires - OFPPT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=Africa/Casablanca

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# --- Mots de passe INTERNAT : Argon2id (config/hashing.php) -------------------
# Mémoire en Kio et nombre de passes. Les empreintes bcrypt antérieures restent
# acceptées et sont recalculées en Argon2id à la première connexion réussie.
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données : MySQL 8 (InnoDB, utf8mb4, mode strict) -----------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=internat
DB_USERNAME=internat
DB_PASSWORD=

# --- Sessions (SPA Sanctum : cookies + CSRF) ---------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,localhost:8000,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Derrière un proxy ou un répartiteur de charge : son adresse (ou une plage), pour retrouver l'adresse réelle du client.
TRUSTED_PROXIES=

# --- Files d'attente et cache -------------------------------------------------
# `database` fonctionne sans service supplémentaire ; `redis` si Redis est disponible.
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Documents (pièces, reçus, exports) : disque privé ------------------------
FILESYSTEM_DISK=local
INTERNAT_DISQUE_DOCUMENTS=prive
INTERNAT_TAILLE_MAX_KO=5120

# --- Courrier (Mailpit en développement : http://localhost:8025) -------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ne-pas-repondre@internat.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- INTERNAT -----------------------------------------------------------------
# Bandeau « Démonstration » et fournisseur MyWay simulé. Toujours false en production.
INTERNAT_MODE_DEMO=true

# Fournisseur d'identité des stagiaires, sollicité UNE fois par stagiaire, à la première connexion.
# `mock`, `connecteur` ou `approuve`. Aucun ne remplace l'autre en silence.
#   mock ........ profils synthétiques. Honoré seulement avec INTERNAT_MODE_DEMO=true et hors production.
#   connecteur .. OUTIL DE DIAGNOSTIC : connexion réelle à MyWay par le service myway-connector, pour les
#                 seuls comptes listés ci-dessous. Jamais en production, jamais exposé publiquement.
#   approuve .... intégration officielle ; aucune méthode de vérification tant que l'OFPPT n'a pas communiqué
#                 de mécanisme : la première connexion est alors fermée (elle n'est jamais simulée).
MYWAY_FOURNISSEUR=mock
# Validité, en minutes, de l'autorisation d'activation délivrée par une vérification réussie.
INTERNAT_ACTIVATION_MINUTES=30
# Conservation, en jours, des vérifications closes avant suppression.
INTERNAT_CONSERVATION_VERIFICATIONS_JOURS=90
MYWAY_API_URL=
MYWAY_CLIENT_ID=
MYWAY_CLIENT_SECRET=
MYWAY_TIMEOUT=10

# --- Connecteur MyWay (MYWAY_FOURNISSEUR=connecteur) — voir myway-connector/README.md ---
# Valeurs produites par « node src/cli/initialiser.ts » dans myway-connector/. Aucun mot de passe MyWay ici.
MYWAY_CONNECTEUR_URL=http://127.0.0.1:8787
# Même valeur que CONNECTEUR_JETON du connecteur (32 caractères au moins).
MYWAY_CONNECTEUR_JETON=
# Adresses MyWay dont le TITULAIRE a autorisé la vérification, séparées par des virgules. Vide : tout est refusé.
MYWAY_COMPTES_AUTORISES=
MYWAY_CONNECTEUR_TIMEOUT=90

# Mot de passe commun des comptes de démonstration créés par le seeder (jamais en production).
INTERNAT_DEMO_MOT_DE_PASSE="Demo-Internat-2026"

# --- Stockage S3 (optionnel) --------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
